<Window x:Class="Rondel.Windows.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Rondel.Windows.UI"
        Title="Rondel"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the mark, the name and the tagline, over a thin line in the brand gradient. -->
        <StackPanel Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="HeaderIcon" Width="36" Height="36" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{l:Loc Welcome.Title}" />
                    <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Tagline}" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="BrandLine" Height="2" Margin="0,14,0,0" CornerRadius="1" />
        </StackPanel>

        <!-- As wide as the picture; the window takes its width from it. -->
        <StackPanel Grid.Row="1" Width="532" Margin="24,16,24,20">
            <!-- The gesture, played in a loop: a folder window, the pointer, Ctrl and the mouse button, and the menu. -->
            <Border x:Name="StageFrame" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Canvas x:Name="Stage" Width="530" Height="290" ClipToBounds="True">
                    <!-- A File Explorer window with a few items and room around them. -->
                    <Border x:Name="Folder" Canvas.Left="20" Canvas.Top="18" Width="386" Height="254" CornerRadius="6" BorderThickness="1">
                        <DockPanel>
                            <Border x:Name="FolderBar" DockPanel.Dock="Top" Height="30" CornerRadius="6,6,0,0" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="FolderGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Text="&#xE8B7;"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="FolderName" Margin="8,0,0,0" FontSize="12" Text="weather-api" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <WrapPanel x:Name="FolderItems" Margin="14,12,0,0" />
                        </DockPanel>
                    </Border>

                    <!-- What the chosen slice starts: a terminal with the agent. -->
                    <Border x:Name="Terminal" Canvas.Left="70" Canvas.Top="62" Width="320" Height="150" CornerRadius="6" BorderThickness="1"
                            Background="#0C0C0C" BorderBrush="#3A3A3A" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="TerminalScale" />
                        </Border.RenderTransform>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="26" Background="#202020" CornerRadius="6,6,0,0" Padding="10,0">
                                <TextBlock x:Name="TerminalTitle" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TerminalText" Margin="10,8" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#CCCCCC"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- The menu as it opens, and with a slice under the pointer. -->
                    <Image x:Name="MenuIdle" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="MenuIdleScale" />
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="MenuHot" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="MenuHotScale" />
                        </Image.RenderTransform>
                    </Image>

                    <!-- Holding the button: a ring fills around the pointer, then the menu opens. -->
                    <Ellipse x:Name="Ripple" StrokeThickness="2" Opacity="0" />
                    <Path x:Name="HoldRing" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="Pointer" Fill="White" Stroke="Black" StrokeThickness="1.1" StrokeLineJoin="Round"
                          Data="M0,0 L0,17.5 L4.4,13.3 L7.4,20.2 L10.3,19 L7.4,12.2 L13.2,12.2 Z" />

                    <!-- Ctrl and the mouse, lit while pressed. -->
                    <StackPanel x:Name="Keys" Canvas.Left="420" Canvas.Top="200" Orientation="Horizontal">
                        <Border x:Name="CtrlKey" Width="50" Height="36" CornerRadius="6" BorderThickness="1,1,1,3">
                            <TextBlock x:Name="CtrlText" Text="Ctrl" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Plus" Text="+" FontSize="16" Margin="7,0" VerticalAlignment="Center" />
                        <Grid Width="28" Height="44" VerticalAlignment="Center">
                            <Border x:Name="MouseBody" CornerRadius="14" BorderThickness="1.5" />
                            <Border x:Name="MouseLeft" Width="13" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.5,1.5,0,0"
                                    CornerRadius="12.5,0,0,0" />
                            <Border x:Name="MouseSplit" Width="1.5" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1.5,0,0" />
                        </Grid>
                    </StackPanel>
                </Canvas>
            </Border>

            <!-- The three steps, the current one lit as the picture plays. -->
            <StackPanel x:Name="Steps" Margin="2,16,0,0" />

            <TextBlock Margin="2,14,0,0" Style="{StaticResource Description}" Text="{l:Loc Welcome.Note}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Padding="12,5" HorizontalAlignment="Left" Content="{l:Loc Welcome.Settings}" Click="OnSettings" />
                <Button Grid.Column="1" Padding="16,5" MinWidth="110" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
                        Content="{l:Loc Welcome.Start}" Click="OnStart" />
            </Grid>
        </Border>
    </Grid>
</Window>
