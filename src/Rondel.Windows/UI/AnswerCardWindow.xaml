<Window x:Class="Rondel.Windows.UI.AnswerCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rondel"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- A button under the answer: a pill like the menu card's chips, lit by the focus ring. Colors come from the palette. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="13,5,13,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="FocusRing" Margin="-3" CornerRadius="16" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource ChipOnBorder}" Visibility="Hidden" />
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ChipOnBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The card's main step: filled, so it reads first. -->
        <Style x:Key="CardPrimaryButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Foreground" Value="{DynamicResource ChipOnText}" />
            <Setter Property="Background" Value="{DynamicResource ChipOnFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipOnBorder}" />
        </Style>
        <!-- The header's close button, as on the agents card. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow; the window is as large as what it shows. -->
    <Grid x:Name="Root" Margin="16">
        <Border x:Name="Card" Width="470" CornerRadius="14" BorderThickness="1.2" Padding="16,12,12,12">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="26" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.4" />
            </Border.Effect>
            <StackPanel>
                <!-- Dragging the header moves the card. -->
                <DockPanel x:Name="Header" Background="Transparent" Cursor="SizeAll">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Top">
                        <TextBlock x:Name="CloseGlyph" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <StackPanel Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TitleGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </StackPanel>
                        <TextBlock x:Name="LocationText" FontSize="11" Margin="0,3,0,10" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Margin="0,0,4,0">
                    <!-- Ask About a Screenshot: the picture the question is about. -->
                    <Border x:Name="ShotFrame" CornerRadius="8" BorderThickness="1" Margin="0,0,0,10" Padding="1" Visibility="Collapsed"
                            HorizontalAlignment="Left">
                        <Image x:Name="ShotImage" Stretch="Uniform" MaxWidth="436" MaxHeight="120" HorizontalAlignment="Left" />
                    </Border>
                    <Border x:Name="QuestionFrame" CornerRadius="8" Padding="10,7,10,8" Margin="0,0,0,10">
                        <TextBlock x:Name="QuestionText" FontSize="12.5" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <RichTextBox x:Name="AnswerText" IsReadOnly="True" IsDocumentEnabled="True" IsTabStop="False" BorderThickness="0"
                                 Background="Transparent" Padding="0" Margin="-4,0,-4,0" MaxHeight="400" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                    <TextBlock x:Name="AnswerStatus" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap" />
                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                        <Button x:Name="CopyAnswer" Style="{StaticResource CardButton}" DockPanel.Dock="Left" />
                        <Button x:Name="ContinueAnswer" Style="{StaticResource CardPrimaryButton}" DockPanel.Dock="Right" />
                        <Button x:Name="CloseAnswer" Style="{StaticResource CardButton}" DockPanel.Dock="Right" Margin="0,0,8,0" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
