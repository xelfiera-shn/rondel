<Window x:Class="Rondel.Windows.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Rondel.Windows.UI"
        Title="{l:Loc Settings.Title}"
        Width="680" Height="760" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock" BasedOn="{StaticResource Description}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <!-- A theme to choose: its preview and name in a frame that is lit while chosen. -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Width="102" Padding="5,6,5,8" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An accent pair to choose: a round swatch of its gradient (Background), ringed while chosen. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="Transparent" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: icon, name and tagline over a thin line in the brand gradient. -->
        <StackPanel Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="HeaderIcon" Width="36" Height="36" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Rondel" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Description}" Margin="0,0,0,0" Text="{l:Loc Settings.Tagline}" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="BrandLine" Height="2" Margin="0,14,0,0" CornerRadius="1" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,16">

                <!-- General -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.General}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:Loc Settings.Language}" />
                            <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Language.Desc}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Tag="auto" Content="{l:Loc Settings.Language.Auto}" />
                            <ComboBoxItem Tag="en" Content="English" />
                            <ComboBoxItem Tag="tr" Content="Türkçe" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Settings.ProjectsRoot}" />
                        <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.ProjectsRoot.Desc}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootBox" VerticalContentAlignment="Center" LostKeyboardFocus="OnRootCommitted" KeyDown="OnTextBoxKeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,5" Content="{l:Loc Settings.Browse}" Click="OnBrowseRoot" />
                        </Grid>
                        <TextBlock x:Name="RootStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.Appearance}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Settings.Theme}" />
                        <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Theme.Desc}" />
                        <WrapPanel x:Name="ThemeCards" Margin="0,12,0,-10" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:Loc Settings.Mode}" />
                            <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Mode.Desc}" />
                        </StackPanel>
                        <ComboBox x:Name="ModeBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="OnModeChanged">
                            <ComboBoxItem Tag="Auto" Content="{l:Loc Settings.Mode.Auto}" />
                            <ComboBoxItem Tag="Dark" Content="{l:Loc Settings.Mode.Dark}" />
                            <ComboBoxItem Tag="Light" Content="{l:Loc Settings.Mode.Light}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Settings.Accent}" />
                        <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Accent.Desc}" />
                        <StackPanel Orientation="Horizontal" Margin="-5,10,0,0">
                            <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" />
                            <TextBlock x:Name="AccentName" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="CustomAccent" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="{l:Loc Settings.Accent.From}" VerticalAlignment="Center" />
                            <TextBox x:Name="AccentFromBox" Width="110" Margin="8,0,20,0" VerticalContentAlignment="Center"
                                     LostKeyboardFocus="OnCustomAccentCommitted" KeyDown="OnTextBoxKeyDown" />
                            <TextBlock Text="{l:Loc Settings.Accent.To}" VerticalAlignment="Center" />
                            <TextBox x:Name="AccentToBox" Width="110" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                     LostKeyboardFocus="OnCustomAccentCommitted" KeyDown="OnTextBoxKeyDown" />
                        </StackPanel>
                        <TextBlock x:Name="AccentStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <!-- Trigger -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.Trigger}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:Loc Settings.HoldMs}" />
                            <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.HoldMs.Desc}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="HoldSlider" Width="180" Minimum="150" Maximum="1000" SmallChange="50" LargeChange="100"
                                    TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnHoldChanged" />
                            <TextBlock x:Name="HoldValue" Width="60" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:Loc Settings.Hotkey}" />
                                <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Hotkey.Desc}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="HotkeyBox" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         VerticalContentAlignment="Center" PreviewKeyDown="OnHotkeyKeyDown" />
                                <Button Margin="8,0,0,0" Padding="12,5" Content="{l:Loc Settings.Hotkey.Clear}" Click="OnClearHotkey" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <!-- Launch -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.Launch}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="CommandLabel" />
                                <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Command.Desc}" />
                            </StackPanel>
                            <TextBox x:Name="CommandBox" Grid.Column="1" Width="240" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     LostKeyboardFocus="OnCommandCommitted" KeyDown="OnTextBoxKeyDown" />
                        </Grid>
                        <TextBlock x:Name="CommandStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:Loc Settings.Terminal}" />
                                <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Terminal.Desc}" />
                            </StackPanel>
                            <ComboBox x:Name="TerminalBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="OnTerminalChanged">
                                <ComboBoxItem Tag="Auto" Content="{l:Loc Settings.Terminal.Auto}" />
                                <ComboBoxItem Tag="WindowsTerminal" Content="{l:Loc Settings.Terminal.WindowsTerminal}" />
                                <ComboBoxItem Tag="Console" Content="{l:Loc Settings.Terminal.Console}" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TerminalStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:Loc Settings.Shell}" />
                                <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Shell.Desc}" />
                            </StackPanel>
                            <ComboBox x:Name="ShellBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="OnShellChanged">
                                <ComboBoxItem Tag="Auto" Content="{l:Loc Settings.Shell.Auto}" />
                                <ComboBoxItem Tag="Pwsh" Content="{l:Loc Settings.Shell.Pwsh}" />
                                <ComboBoxItem Tag="WindowsPowerShell" Content="{l:Loc Settings.Shell.WindowsPowerShell}" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="ShellStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <!-- Active agents -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.ActiveAgents}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="FollowAgentsBox" Content="{l:Loc Settings.ActiveAgents.Follow}" Click="OnActiveAgentsClicked" />
                        <TextBlock Style="{StaticResource Description}" Margin="28,2,0,0" Text="{l:Loc Settings.ActiveAgents.Follow.Desc}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="AgentNotificationsPanel">
                        <TextBlock Text="{l:Loc Settings.ActiveAgents.Notify}" />
                        <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.ActiveAgents.Notify.Desc}" />
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="NotifyAsksBox" Margin="0,0,24,0" Content="{l:Loc Settings.ActiveAgents.NotifyAsks}" Click="OnActiveAgentsClicked" />
                            <CheckBox x:Name="NotifyFinishedBox" Content="{l:Loc Settings.ActiveAgents.NotifyFinished}" Click="OnActiveAgentsClicked" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:Loc Settings.ActiveAgents.Hotkey}" />
                                <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.ActiveAgents.Hotkey.Desc}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="AgentsHotkeyBox" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         VerticalContentAlignment="Center" PreviewKeyDown="OnAgentsHotkeyKeyDown" />
                                <Button Margin="8,0,0,0" Padding="12,5" Content="{l:Loc Settings.Hotkey.Clear}" Click="OnClearAgentsHotkey" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AgentsHotkeyStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="AgentsCardPanel">
                        <CheckBox x:Name="CardShowBox" Content="{l:Loc Settings.ActiveAgents.Card.Show}" Click="OnAgentsCardClicked" />
                        <TextBlock Style="{StaticResource Description}" Margin="28,2,0,0" Text="{l:Loc Settings.ActiveAgents.Card.Show.Desc}" />
                        <StackPanel x:Name="CardOptions" Margin="28,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{l:Loc Card.Placement}" />
                                <ComboBox x:Name="CardPlacementBox" Grid.Column="1" Width="240" VerticalAlignment="Center" SelectionChanged="OnCardPlacementChanged">
                                    <ComboBoxItem Tag="OnTop" Content="{l:Loc Card.OnTop}" />
                                    <ComboBoxItem Tag="OnDesktop" Content="{l:Loc Card.OnDesktop}" />
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="CardFullScreenBox" Margin="0,12,0,0" Content="{l:Loc Settings.ActiveAgents.Card.OverFullScreen}" Click="OnAgentsCardClicked" />
                            <TextBlock Style="{StaticResource Description}" Margin="28,2,0,0" Text="{l:Loc Settings.ActiveAgents.Card.OverFullScreen.Desc}" />
                            <CheckBox x:Name="CardMuteBox" Margin="0,10,0,0" Content="{l:Loc Card.Mute}" Click="OnAgentsCardClicked" />
                            <TextBlock Style="{StaticResource Description}" Margin="28,2,0,0" Text="{l:Loc Settings.ActiveAgents.Card.Mute.Desc}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{l:Loc Settings.ActiveAgents.Card.Hotkey}" />
                                <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.ActiveAgents.Card.Hotkey.Desc}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="CardHotkeyBox" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         VerticalContentAlignment="Center" PreviewKeyDown="OnCardHotkeyKeyDown" />
                                <Button Margin="8,0,0,0" Padding="12,5" Content="{l:Loc Settings.Hotkey.Clear}" Click="OnClearCardHotkey" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CardHotkeyStatus" Style="{StaticResource Status}" />
                    </StackPanel>
                </Border>

                <!-- New project -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.NewProject}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Settings.NewProject.Options}" />
                        <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.NewProject.Options.Desc}" />
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="CardPromptBox" Margin="0,0,24,0" Content="{l:Loc NewProject.Prompt}" Click="OnNewProjectCardClicked" />
                            <CheckBox x:Name="CardGitBox" Margin="0,0,24,0" Content="{l:Loc NewProject.Git}" Click="OnNewProjectCardClicked" />
                            <CheckBox x:Name="CardPlanBox" Margin="0,0,24,0" Content="{l:Loc NewProject.Plan}" Click="OnNewProjectCardClicked" />
                            <CheckBox x:Name="CardTemplatesBox" Content="{l:Loc NewProject.Templates}" Click="OnNewProjectCardClicked" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:Loc Settings.Templates}" />
                            <TextBlock Style="{StaticResource Description}" Text="{l:Loc Settings.Templates.Desc}" />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="12,5" VerticalAlignment="Center" Content="{l:Loc NewProject.OpenTemplates}" Click="OnOpenTemplates" />
                    </Grid>
                </Border>

                <!-- System -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Settings.System}" />

                <Border Style="{StaticResource Card}">
                    <CheckBox x:Name="AutostartBox" Content="{l:Loc Settings.Autostart}" Click="OnAutostartClicked" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="CheckUpdatesBox" Content="{l:Loc Settings.Updates.Check}" Click="OnCheckUpdatesClicked" />
                        <TextBlock Style="{StaticResource Description}" Margin="28,2,0,0" Text="{l:Loc Settings.Updates.Check.Desc}" />
                        <Grid Margin="28,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Description}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Button x:Name="CheckNowButton" Grid.Column="1" Padding="12,5" VerticalAlignment="Center" Click="OnCheckNow" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="DebugBox" Content="{l:Loc Settings.Debug}" Click="OnDebugClicked" />
                        <TextBlock Style="{StaticResource Description}" Margin="28,2,0,0" Text="{l:Loc Settings.Debug.Desc}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Padding="12,5" Content="{l:Loc Settings.EditJson}" Click="OnEditJson" />
                    <Button Margin="8,0,0,0" Padding="12,5" Content="{l:Loc Settings.OpenLogs}" Click="OnOpenLogs" />
                    <TextBlock x:Name="VersionText" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Description}" />
                </StackPanel>
                <Button Grid.Column="1" Padding="20,5" MinWidth="90" Content="{l:Loc Settings.Close}" IsCancel="True" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
