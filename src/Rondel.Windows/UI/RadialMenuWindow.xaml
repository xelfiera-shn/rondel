<Window x:Class="Rondel.Windows.UI.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rondel"
        Width="820" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- Flat text box that takes its colors from the menu palette (set from code). -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                                <!-- Margin is replaced from code with the caret position of the empty box. -->
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Top" Opacity="0.5" IsHitTestVisible="False" Visibility="Collapsed"
                                           Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An option on the New Project card: a pill that is lit while it is on. Colors come from the menu palette (set from code). -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="11,4,12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource ChipText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="FocusRing" Margin="-3" CornerRadius="16" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource ChipOnBorder}" Visibility="Hidden" />
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Check" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;"
                                               Margin="0,1,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ChipOnBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="{DynamicResource ChipOnFill}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ChipOnBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource ChipOnText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Surface carries the open/close animation for both the ring and the input card. -->
    <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="SurfaceScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- The stage is the whole window; every shape is placed around its center (410, 410). -->
        <!-- The window may be smaller than the stage (see StageSizeFor); the stage stays centered in it. -->
        <Grid x:Name="MenuRoot" Width="820" Height="820" HorizontalAlignment="Center" VerticalAlignment="Center"
              Focusable="True" FocusVisualStyle="{x:Null}">

            <!-- Full disc under the slices, so the gaps between them never let a click fall through. -->
            <Ellipse x:Name="RingBase" Width="336" Height="336" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="RingShadow" BlurRadius="30" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.4" />
                </Ellipse.Effect>
            </Ellipse>

            <Canvas x:Name="SliceLayer" Width="820" Height="820" IsHitTestVisible="False" />

            <!-- Hub: a thin brand-colored ring around the center disc. -->
            <Ellipse x:Name="HubRing" Width="114" Height="114" StrokeThickness="1.6" IsHitTestVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse x:Name="Hub" Width="104" Height="104" IsHitTestVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel x:Name="CenterContent" Width="88" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="CenterGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           HorizontalAlignment="Center" Margin="0,0,0,3" Text="&#xE8B7;" />
                <TextBlock x:Name="CenterTitle" FontSize="12.5" FontWeight="SemiBold" TextAlignment="Center"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                <TextBlock x:Name="CenterSubtitle" FontSize="10.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            </StackPanel>

            <!-- An open slice's items, on an arc outside the ring centered on that slice. -->
            <Canvas x:Name="ChildLayer" Width="820" Height="820" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="ChildScale" ScaleX="1" ScaleY="1" />
                </Canvas.RenderTransform>
                <Canvas.Effect>
                    <DropShadowEffect x:Name="ChildShadow" BlurRadius="22" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.35" />
                </Canvas.Effect>
            </Canvas>

            <!-- One more arc further out: the sessions of an item on the first arc (e.g. a recent project). -->
            <Canvas x:Name="GrandLayer" Width="820" Height="820" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="GrandScale" ScaleX="1" ScaleY="1" />
                </Canvas.RenderTransform>
                <Canvas.Effect>
                    <DropShadowEffect x:Name="GrandShadow" BlurRadius="22" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.35" />
                </Canvas.Effect>
            </Canvas>
        </Grid>

        <!-- The menu center expands into this card for "New Project" / "New + Prompt". -->
        <Border x:Name="InputCard" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="14" BorderThickness="1.2" Padding="16,14,16,12" Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="InputScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="30" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.4" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="InputGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="InputTitle" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="290" />
                </StackPanel>
                <TextBlock x:Name="InputLocation" FontSize="11" Margin="0,3,0,10" TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" />
                <!-- New Project only: how the project starts, and the templates copied into it. -->
                <StackPanel x:Name="NewOptions" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StartLabel" FontSize="11" Margin="1,0,0,6" />
                    <WrapPanel x:Name="StartChips" />
                    <DockPanel x:Name="TemplatesHeader" Margin="1,6,0,6">
                        <TextBlock x:Name="OpenTemplates" DockPanel.Dock="Right" FontSize="11" Cursor="Hand" />
                        <TextBlock x:Name="TemplatesLabel" FontSize="11" />
                    </DockPanel>
                    <WrapPanel x:Name="TemplateChips" />
                    <TextBlock x:Name="NoTemplates" FontSize="11" TextWrapping="Wrap" Margin="1,0,0,4" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="PromptLabel" FontSize="11" Margin="1,6,0,6" Visibility="Collapsed" />
                <TextBox x:Name="PromptBox" Style="{StaticResource InputBox}" Height="132" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                <TextBlock x:Name="InputMessage" FontSize="11.5" Margin="1,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
