<Window x:Class="Rondel.Windows.UI.AgentsCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rondel"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- A small round button for the header's icons; its hover color comes from the palette (set from code). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow; the window is as large as what it shows. -->
    <Grid x:Name="Root" Margin="14">
        <!-- Open: the agents, waiting ones first. -->
        <Border x:Name="Card" Width="300" CornerRadius="14" BorderThickness="1.2" Padding="0,0,0,6">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="22" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
                <!-- The header is where the card is dragged from. -->
                <Grid x:Name="Header" Margin="12,9,7,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Mark" Width="18" Height="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="SummaryText" FontSize="11.5" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="MenuButton" Grid.Column="2" Style="{StaticResource IconButton}">
                        <TextBlock x:Name="MenuGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="PinButton" Grid.Column="3" Margin="2,0,0,0" Style="{StaticResource IconButton}">
                        <TextBlock x:Name="PinGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </Grid>
                <Border x:Name="Divider" Height="1" Margin="12,0,12,4" />
                <StackPanel x:Name="Rows" />
                <TextBlock x:Name="EmptyText" Margin="14,6,14,6" FontSize="12" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Collapsed: Rondel's mark, with the number of agents that need the user. -->
        <Grid x:Name="Badge" Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
              Background="Transparent">
            <Ellipse x:Name="BadgeBack" StrokeThickness="1.2">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="BadgeShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.35" />
                </Ellipse.Effect>
            </Ellipse>
            <Image x:Name="BadgeMark" Width="30" Height="30" />
            <Border x:Name="CountBack" MinWidth="20" Height="20" CornerRadius="10" Padding="5,0" Margin="0,-5,-5,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="CountText" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
