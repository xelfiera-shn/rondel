<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rondel.Core</RootNamespace>
    <!-- The macOS app is published with NativeAOT: the analyzers flag anything in the core that would break it. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rondel.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public half of Rondel's release key: updates are taken only when the release workflow signed them with it. -->
    <EmbeddedResource Include="Updates\release-key.pem" LogicalName="Rondel.ReleaseKey.pem" />
  </ItemGroup>

</Project>
