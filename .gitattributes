# Text files are stored with LF in the repository and checked out with CRLF.
* text=auto eol=crlf

# Shell scripts run on macOS and Linux: a CR after the #! line would break them.
*.sh text eol=lf

# The macOS app's entitlements: older codesign versions refuse a plist with CR line ends.
*.entitlements text eol=lf

*.ico binary
*.png binary
*.icns binary
*.jpg binary
*.gif binary
