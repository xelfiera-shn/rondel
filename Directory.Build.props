<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local builds are 0.0.0; the release workflow passes the computed version with -p:Version=X.Y.Z. -->
    <Version>0.0.0</Version>
    <Product>Rondel</Product>
    <Authors>Ahmet Şahin</Authors>
    <Copyright>Copyright (c) Ahmet Şahin</Copyright>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
